# AI Customer Support Coaching Assistant - Environment Variables
APP_NAME="AI Customer Support Coaching Assistant"
APP_ENV="development"
DEBUG=True
PORT=8000

# Database
DATABASE_URL="sqlite:///./support_coaching.db"

# ChromaDB Persistent Storage
CHROMA_PERSIST_DIR="./chroma_storage"
CHROMA_COLLECTION_NAME="kb_chunks"

# RAG & Embeddings Configuration
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
MAX_CHUNK_TOKENS=240
RETRIEVAL_TOP_K=4
RETRIEVAL_SIMILARITY_THRESHOLD=0.35

# Offline SentenceTransformers Execution
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# LLM Configuration (Deferred for Milestone 2)
LLM_PROVIDER="none"
LLM_API_KEY=""
