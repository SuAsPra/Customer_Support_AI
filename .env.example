# Copy to .env and fill in values as needed.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/app.db

# LLM provider: openai | gemini | anthropic | ollama | none
# "none" uses local/fallback behavior where possible (Milestone 1 RAG works without LLM).
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Embeddings: sentence-transformers (local) | openai
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG
CHROMA_PERSIST_DIR=./data/chroma
CHUNK_SIZE=450
CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=5
